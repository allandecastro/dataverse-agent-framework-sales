# Normalise line endings. LF everywhere by default so diffs stay clean across
# macOS, Linux and Windows. Windows-native script types keep CRLF.
* text=auto eol=lf

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary assets, never normalised.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
