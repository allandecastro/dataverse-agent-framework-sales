<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Pin the feed to nuget.org only. A public repo should not restore from an
       inherited machine feed. NuGet audit stays on and surfaces vulnerable packages. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>

</configuration>
