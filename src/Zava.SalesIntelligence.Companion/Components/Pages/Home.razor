@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.Agents.AI.Workflows
@using Zava.SalesIntelligence.Agents.Contracts
@using Zava.SalesIntelligence.Workflow
@inject WorkflowFactory Factory
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Zava Sales Intelligence</PageTitle>

<style>
    :root {
        --ink: #242424; --ink-2: #424242; --muted: #616161; --faint: #6e6e6e; /* AA contrast on small text */
        --stroke: #e0e0e0; --stroke-2: #efefef; --hover: #f5f5f5; --card: #ffffff; --canvas: #fafafa;
        --brand: #0f6cbd; --brand-deep: #115ea3; --brand-tint: #eff6fc;
        --slip: #c50f1f; --risk: #bc4b09; --recon: #5b5fc7; --ready: #107c10; --teal: #038387;
        --shadow-2: 0 1px 2px rgba(0,0,0,.07), 0 0 1px rgba(0,0,0,.05);
        --shadow-8: 0 4px 8px rgba(0,0,0,.07), 0 0 2px rgba(0,0,0,.06);
        --shadow-16: 0 8px 20px rgba(0,0,0,.09), 0 0 2px rgba(0,0,0,.06);
        --ease: cubic-bezier(.33,0,.1,1);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    /* Font stack on body so fixed elements outside .app (the composer, the log drawer) inherit it too. */
    body { background: var(--canvas); min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif; }
    .app { color: var(--ink); max-width: 1200px; margin: 0 auto; padding: 40px 32px 180px;
        -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

    .head { display: flex; align-items: center; justify-content: space-between; gap: 24px;
        padding-bottom: 26px; margin-bottom: 34px; border-bottom: 1px solid var(--stroke); }
    .head .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 11.5px; letter-spacing: .1em;
        text-transform: uppercase; color: var(--muted); font-weight: 600; }
    .head .brand::before { content: ""; width: 8px; height: 8px; border-radius: 3px; background: var(--brand); }
    .head h1 { font-size: 30px; letter-spacing: -.02em; margin: 10px 0 0; font-weight: 600; color: var(--ink); }
    .run { display: inline-flex; align-items: center; gap: 7px; font-size: 15px; font-weight: 600; padding: 10px 22px;
        border: 0; border-radius: 8px; color: #fff; background: var(--brand); cursor: pointer; box-shadow: var(--shadow-2);
        transition: background .12s var(--ease); }
    .run:hover { background: var(--brand-deep); }
    .working { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); font-weight: 600; font-size: 14.5px; }
    .spinner { width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(15,108,189,.2);
        border-top-color: var(--brand); animation: spin .7s linear infinite; }

    .layout { display: grid; grid-template-columns: 320px 1fr; gap: 32px; align-items: start; }

    .thread { display: flex; flex-direction: column; gap: 8px; }
    .thread .lead { font-size: 11px; letter-spacing: .09em; text-transform: uppercase; color: var(--faint);
        font-weight: 600; padding: 2px 2px 6px; }
    /* The bare input styles the composer reuses; the .ask container/.ask-row rules were removed
       with the old inline ask block (the composer replaced it). */
    .ask-input { width: 100%; font-size: 14px; font-family: inherit; color: var(--ink); }
    .ask-input:focus { outline: none; }
    .mic { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--stroke);
        background: #fff; color: var(--brand); cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
        transition: background .12s var(--ease), color .12s var(--ease), border-color .12s var(--ease); }
    .mic:hover:not(:disabled) { background: var(--brand-tint); }
    .mic:disabled { opacity: .5; cursor: default; }
    .mic.on { background: var(--slip); color: #fff; border-color: var(--slip); animation: pulse 1s ease-in-out infinite; }
    @@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(197,15,31,.5); } 50% { box-shadow: 0 0 0 7px rgba(197,15,31,0); } }

    /* The pinned companion composer: the always-in-reach surface to talk to the squad. */
    .composer { position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 40;
        width: min(660px, 92vw); display: flex; flex-direction: column; gap: 12px; }
    .composer-log { display: flex; flex-direction: column; gap: 8px; max-height: 42vh; overflow-y: auto; padding: 2px; }
    .composer .qa { background: var(--card); border: 1px solid var(--stroke); border-radius: 14px;
        padding: 11px 15px; box-shadow: var(--shadow-8); animation: rise .22s var(--ease) both; }
    .composer .q { font-size: 12.5px; font-weight: 650; color: var(--muted); margin-bottom: 4px; }
    .composer .q::before { content: "You"; margin-right: 7px; color: var(--faint); font-weight: 700; font-size: 10px; text-transform: uppercase; }
    .composer .a { font-size: 14.5px; line-height: 1.5; color: var(--ink); white-space: pre-wrap; }
    .composer .a.thinking { color: var(--muted); font-style: italic; display: flex; align-items: center; gap: 8px; }
    .composer .a-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .composer .a-links .record-link { margin-left: 0; }
    .composer-done { display: flex; flex-direction: column; gap: 6px; background: #f2fbf4; border: 1px solid #bfe6c8;
        border-radius: 14px; padding: 11px 15px; box-shadow: var(--shadow-8); animation: rise .22s var(--ease) both; }
    .composer-done .cd-row { display: flex; gap: 9px; align-items: baseline; font-size: 14px; color: var(--ink-2); }
    .composer-done .cd-row::before { content: "✓"; color: var(--ready); font-weight: 800; }
    .composer-bar { display: flex; gap: 10px; align-items: center; background: var(--card); border: 1px solid var(--stroke);
        border-radius: 999px; padding: 8px 8px 8px 20px; box-shadow: var(--shadow-16); }
    .composer-bar .ask-input { flex: 1; border: 0; padding: 8px 0; font-size: 15px; background: transparent; color: var(--ink); }
    .composer-bar .ask-input:focus { outline: none; }
    .composer-bar .mic { width: 44px; height: 44px; border-radius: 999px; border-color: var(--brand);
        background: var(--brand); color: #fff; }
    .composer-bar .mic:hover:not(:disabled) { background: var(--brand-deep); border-color: var(--brand-deep); }
    .composer-bar .mic.on { background: var(--slip); border-color: var(--slip); }
    .composer-bar .mic.stop { background: var(--slip); border-color: var(--slip); animation: pulse 1s ease-in-out infinite; }
    .composer-bar .mic.stop:hover { background: var(--slip); }
    .step { position: relative; display: flex; gap: 12px; align-items: flex-start; background: var(--card);
        border: 1px solid var(--stroke); border-radius: 8px; padding: 12px 15px; font-size: 14px; line-height: 1.45;
        color: var(--ink-2); box-shadow: var(--shadow-2); animation: rise .3s var(--ease) both; }
    .step .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); margin-top: 6px; flex: 0 0 auto; }
    .step:last-child .dot { background: var(--recon); }
    .step.active { color: var(--muted); font-style: italic; background: var(--canvas); border-style: dashed; }
    .spinner.sm { width: 12px; height: 12px; border-width: 2px; margin-top: 3px; flex: 0 0 auto; }

    .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .col { background: var(--card); border: 1px solid var(--stroke); border-radius: 10px; overflow: hidden; box-shadow: var(--shadow-2); }
    .col > header { color: #fff; padding: 12px 15px; font-weight: 600; font-size: 14px;
        display: flex; justify-content: space-between; align-items: center; }
    .col .body { padding: 10px; display: flex; flex-direction: column; gap: 8px; min-height: 60px; }
    .col.Slipping > header { background: var(--slip); } .col.AtRisk > header { background: var(--risk); }
    .col.Reconnect > header { background: var(--recon); } .col.ReadyToClose > header { background: var(--ready); }
    .col .count { background: rgba(255,255,255,.24); border-radius: 999px; padding: 1px 9px; font-size: 12.5px; font-weight: 600; }
    .col .empty { color: var(--faint); font-size: 12.5px; text-align: center; padding: 10px 0; }
    .acct { width: 100%; text-align: left; font-family: inherit; background: var(--card); display: flex;
        justify-content: space-between; align-items: center; gap: 8px; cursor: pointer;
        border: 1px solid var(--stroke-2); border-radius: 6px; padding: 10px 12px; font-size: 14px; font-weight: 600;
        color: var(--ink); transition: background .12s var(--ease), border-color .12s var(--ease); }
    .acct:hover { background: var(--hover); border-color: var(--stroke); }
    .acct:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    .acct .bant { font-size: 11px; font-weight: 700; color: #fff; border-radius: 999px; padding: 2px 8px;
        letter-spacing: .01em; background: var(--faint); }
    .acct .bant.b4 { background: var(--ready); } .acct .bant.b3 { background: var(--teal); }
    .acct .bant.b2 { background: var(--risk); } .acct .bant.b1 { background: var(--slip); }

    .panel { background: var(--card); border: 1px solid var(--stroke); border-radius: 12px; padding: 26px 28px;
        margin-top: 24px; box-shadow: var(--shadow-16); animation: rise .28s var(--ease) both; }
    .panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .panel-close { background: transparent; border: 0; color: var(--muted); font-size: 26px; line-height: 1;
        cursor: pointer; padding: 0 4px; border-radius: 6px; }
    .panel-close:hover { color: var(--ink); background: var(--hover); }
    .panel-close:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    .panel h2 { margin: 0 0 6px; font-size: 21px; letter-spacing: -.01em; font-weight: 600; }
    .panel .sub { color: var(--muted); margin: 0 0 18px; font-size: 14.5px; }
    .lens { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; color: var(--recon);
        background: #f2f3fb; border-radius: 6px; padding: 5px 10px; display: inline-block; margin-bottom: 6px; }
    .axis { padding: 14px 0; border-top: 1px solid var(--stroke-2); font-size: 14.5px; line-height: 1.5; }
    .axis .name { font-weight: 600; margin-right: 8px; }
    .axis .quote { color: var(--muted); font-style: italic; margin-top: 4px; }
    .status { font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 999px; color: #fff; letter-spacing: .01em; }
    .Confirmed { background: var(--ready); } .Partial { background: var(--risk); } .Missing { background: var(--faint); }

    .prop { display: flex; gap: 13px; align-items: flex-start; padding: 14px 0; border-top: 1px solid var(--stroke-2); font-size: 15px; }
    .prop input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--brand); cursor: pointer; }
    .prop .tag { display: inline-block; min-width: 96px; text-align: center; font-size: 10.5px; font-weight: 700; color: #fff;
        border-radius: 4px; padding: 3px 8px; margin-right: 11px; text-transform: uppercase; letter-spacing: .04em; background: var(--muted); }
    .prop .tag.Task { background: var(--brand); } .prop .tag.Appointment { background: var(--recon); }
    .prop .tag.StageUpdate { background: var(--risk); } .prop .tag.CloseDateUpdate { background: var(--teal); }
    .actions { display: flex; gap: 10px; margin-top: 22px; flex-wrap: wrap; }
    .btn { font-size: 14.5px; font-weight: 600; padding: 10px 20px; border: 1px solid transparent; border-radius: 8px;
        cursor: pointer; transition: background .12s var(--ease), border-color .12s var(--ease); }
    .btn.go { background: var(--brand); color: #fff; }
    .btn.go:hover { background: var(--brand-deep); }
    .btn.ghost { background: #fff; color: var(--ink); border-color: var(--stroke); }
    .btn.ghost:hover { background: var(--hover); }
    .btn.no { background: #fff; color: var(--slip); border-color: var(--stroke); }
    .btn.no:hover { background: #fdf3f4; }
    .done h2 { color: var(--ready); }
    .written { font-size: 15px; padding: 11px 0; border-top: 1px solid var(--stroke-2); display: flex; gap: 9px; align-items: baseline; color: var(--ink-2); }
    .written::before { content: "✓"; color: var(--ready); font-weight: 800; }
    .record-link { margin-left: auto; font-size: 13px; font-weight: 600; color: var(--brand); text-decoration: none;
        white-space: nowrap; padding: 3px 11px; border: 1px solid var(--stroke); border-radius: 6px; transition: background .12s var(--ease), border-color .12s var(--ease); }
    .record-link:hover { background: var(--brand-tint); border-color: var(--brand); }

    .head-actions { display: flex; align-items: center; gap: 12px; }
    .persona { display: inline-flex; border: 1px solid var(--stroke); border-radius: 8px; overflow: hidden; background: #fff; }
    .persona .seg { font-family: inherit; font-size: 13px; font-weight: 650; padding: 8px 14px; border: 0; background: #fff;
        color: var(--muted); cursor: pointer; transition: background .12s var(--ease), color .12s var(--ease); }
    .persona .seg + .seg { border-left: 1px solid var(--stroke); }
    .persona .seg.on { background: var(--brand); color: #fff; }
    .persona .seg:disabled { opacity: .5; cursor: default; }
    .persona .seg:not(.on):not(:disabled):hover { background: var(--hover); color: var(--ink); }
    .persona-hint { font-size: 12px; font-style: italic; color: var(--risk); font-weight: 600; }
    .log-toggle { font-size: 13px; font-weight: 600; padding: 9px 15px; border: 1px solid var(--stroke); border-radius: 8px;
        background: #fff; color: var(--muted); cursor: pointer; transition: background .12s var(--ease), color .12s var(--ease); }
    .log-toggle:hover { background: var(--hover); color: var(--ink); }
    .log-drawer { position: fixed; top: 0; right: 0; height: 100vh; width: 440px; max-width: 92vw; background: #1f1f1f;
        color: #e0e0e0; box-shadow: -12px 0 44px rgba(0,0,0,.3); transform: translateX(100%); transition: transform .24s var(--ease);
        z-index: 50; display: flex; flex-direction: column; }
    .log-drawer.open { transform: translateX(0); }
    .log-drawer > header { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px;
        border-bottom: 1px solid #333; font-weight: 600; font-size: 14.5px; color: #fff; }
    .log-drawer .close { background: transparent; border: 0; color: #a0a0a0; font-size: 22px; line-height: 1; cursor: pointer; }
    .log-drawer .close:hover { color: #fff; }
    .log-body { flex: 1; overflow-y: auto; padding: 12px 14px;
        font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 12.5px; line-height: 1.6; }
    .log-row { display: flex; gap: 9px; padding: 3px 0; border-bottom: 1px solid rgba(255,255,255,.05); align-items: baseline; }
    .log-row .t { color: #808080; flex: 0 0 auto; }
    .log-row .d { color: #5a7fb0; flex: 0 0 auto; min-width: 46px; text-align: right; }
    .log-row .ag { flex: 0 0 auto; min-width: 62px; text-align: center; font-weight: 700; font-size: 10.5px;
        letter-spacing: .03em; padding: 1px 6px; border-radius: 4px; text-transform: uppercase; }
    .log-row .ag-Watcher { background: #14314f; color: #79b0ec; } .log-row .ag-Thinker { background: #33245c; color: #bda2f0; }
    .log-row .ag-Ranker { background: #333; color: #adadad; } .log-row .ag-Operator { background: #143a24; color: #74d59a; }
    .log-row .ag-MEDDPICC { background: #14383a; color: #66c6cb; }
    .log-row .m { color: #d6dde8; white-space: pre-wrap; word-break: break-word; }
    .log-row.thought .m { color: #9fd0ff; font-style: italic; }
    .log-row.err .m { color: #ff9d9d; }
    .log-empty { color: #808080; padding: 12px 2px; }

    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes rise { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: none; } }

    /* Responsive: the two-column layout folds to one, the four cards step down to two then one,
       and the header wraps rather than overflowing. The composer already sizes to min(660px, 92vw). */
    @@media (max-width: 1000px) {
        .layout { grid-template-columns: 1fr; }
        .cards { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 620px) {
        .app { padding: 26px 16px 180px; }
        .head { flex-wrap: wrap; gap: 14px; }
        .head h1 { font-size: 24px; }
        .cards { grid-template-columns: 1fr; }
        .panel { padding: 20px 18px; }
        .composer { bottom: 14px; width: 94vw; }
    }
</style>

<div class="app">
    <div class="head">
        <div>
            <div class="brand">Zava Sales Intelligence</div>
            <h1>What should I focus on this week?</h1>
        </div>
        <div class="head-actions">
            <div class="persona" role="group" aria-label="Persona - the qualification lens for the next run">
                <button type="button" class="seg @(_persona == Persona.Sdr ? "on" : "")"
                        @onclick="() => _persona = Persona.Sdr" disabled="@_running"
                        title="Fast BANT triage">SDR</button>
                <button type="button" class="seg @(_persona == Persona.Ae ? "on" : "")"
                        @onclick="() => _persona = Persona.Ae" disabled="@_running"
                        title="Deep MEDDPICC qualification">AE</button>
            </div>
            @if (_report is not null && _persona != _ranPersona)
            {
                <span class="persona-hint">Re-run to apply</span>
            }
            @if (_running)
            {
                <span class="working"><span class="spinner"></span> The squad is working...</span>
            }
            else
            {
                <button class="run" @onclick="RunAsync">
                    @if (_report is null)
                    {
                        <span>Run the squad</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                            <path d="M12 5V2L8 6l4 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z" />
                        </svg>
                        <span>Refresh</span>
                    }
                </button>
            }
            <button class="log-toggle" @onclick="() => _showLog = !_showLog">
                Logs@(_log.Count > 0 ? $" ({_log.Count})" : "")
            </button>
        </div>
    </div>

    <div class="layout">
        <div class="thread" aria-live="polite">
            @if (_thread.Count > 0)
            {
                <div class="lead">Squad activity</div>
            }
            @foreach (var line in _thread)
            {
                <div class="step"><span class="dot"></span><span>@line</span></div>
            }
            @if (_active is not null)
            {
                <div class="step active"><span class="spinner sm"></span><span>@_active</span></div>
            }
        </div>

        <div class="cards">
            @foreach (var archetype in Cards)
            {
                var accounts = _recommendations.Where(r => r.Assessment.Archetype == archetype).ToList();
                <div class="col @archetype">
                    <header>@Label(archetype) <span class="count">@accounts.Count</span></header>
                    <div class="body">
                        @if (accounts.Count == 0)
                        {
                            <div class="empty">No accounts</div>
                        }
                        @foreach (var recommendation in accounts)
                        {
                            <button type="button" class="acct" @onclick="() => ShowEvidence(recommendation)">
                                <span>@recommendation.Assessment.AccountName</span>
                                @if (recommendation.Meddpicc is { } scorecard)
                                {
                                    <span class="bant @MeddpiccClass(scorecard.Score)">MEDDPICC @scorecard.Score/8</span>
                                }
                                else
                                {
                                    <span class="bant @BantClass(recommendation.Assessment.Bant.Score)">BANT @recommendation.Assessment.Bant.Score</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @if (_evidence is not null)
    {
        <div class="panel">
            <div class="panel-head">
                <h2>@_evidence.Assessment.AccountName</h2>
                <button type="button" class="panel-close" @onclick="() => _evidence = null" aria-label="Close evidence">&times;</button>
            </div>
            <p class="sub">@_evidence.Assessment.Rationale</p>
            @if (_evidence.Meddpicc is { } scorecard)
            {
                @* AE persona: the MEDDPICC read. The BANT triage still drove the archetype/actions. *@
                <div class="lens">MEDDPICC read - @scorecard.Score of 8 confirmed</div>
                @foreach (var (element, criterion) in MeddpiccElements(scorecard))
                {
                    <div class="axis">
                        <span class="name">@element</span> <span class="status @criterion.Status">@criterion.Status</span>
                        <div>@criterion.Reasoning</div>
                        @foreach (var evidence in criterion.Evidence)
                        {
                            <div class="quote">"@evidence.Excerpt" - @evidence.EntityLogicalName, @evidence.Date</div>
                        }
                    </div>
                }
            }
            else
            {
                @foreach (var (axis, criterion) in Axes(_evidence.Assessment.Bant))
                {
                    <div class="axis">
                        <span class="name">@axis</span> <span class="status @criterion.Status">@criterion.Status</span>
                        <div>@criterion.Reasoning</div>
                        @foreach (var evidence in criterion.Evidence)
                        {
                            <div class="quote">"@evidence.Excerpt" - @evidence.EntityLogicalName, @evidence.Date</div>
                        }
                    </div>
                }
            }
        </div>
    }

    @if (_pending is not null)
    {
        <div class="panel">
            <h2>Approve before anything is written</h2>
            <p class="sub">Nothing reaches Dataverse until you say so.</p>
            @foreach (var proposal in _proposals)
            {
                <label class="prop">
                    <input type="checkbox" checked="@_selected.Contains(proposal.Number)"
                           @onchange="e => Toggle(proposal.Number, e)" />
                    <span><span class="tag @proposal.Action.Type">@proposal.Action.Type</span>@proposal.OpportunityName - @proposal.Action.Title</span>
                </label>
            }
            <div class="actions">
                <button class="btn go" @onclick="ApproveAll">Approve all</button>
                <button class="btn ghost" @onclick="ApproveSelected">Approve selected</button>
                <button class="btn no" @onclick="RejectAll">Reject all</button>
            </div>
        </div>
    }

    @if (_report is not null)
    {
        <div class="panel done">
            <h2>Done</h2>
            @foreach (var line in _report.Lines)
            {
                var link = RecordLink(line);
                <div class="written">
                    <span>@line.Message</span>
                    @if (link is not null)
                    {
                        <a class="record-link" href="@link" target="_blank" rel="noopener">Open record</a>
                    }
                </div>
            }
        </div>
    }
</div>

@* The companion's voice-first composer: pinned, centred, always in reach once the run is in.
   The mic is the primary action; the input is the fallback. This is the "talk to it" surface. *@
@if (_chat is not null)
{
    <div class="composer">
        @if (_qa.Count > 0 || _asking)
        {
            <div class="composer-log">
                @foreach (var entry in _qa)
                {
                    <div class="qa">
                        <div class="q">@entry.Question</div>
                        <div class="a">@entry.Answer</div>
                        @if (entry.Writes.Count > 0)
                        {
                            <div class="a-links">
                                @foreach (var write in entry.Writes)
                                {
                                    var link = RecordLink(write);
                                    @if (link is not null)
                                    {
                                        <a class="record-link" href="@link" target="_blank" rel="noopener">Open record</a>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                @if (_asking)
                {
                    <div class="qa"><div class="a thinking"><span class="spinner sm"></span> Thinking...</div></div>
                }
            </div>
        }
        @* Write confirmation right where the seller is looking, with a link straight to each record. *@
        @if (_report is not null)
        {
            <div class="composer-done">
                @foreach (var line in _report.Lines)
                {
                    var link = RecordLink(line);
                    <div class="cd-row">
                        <span>@line.Message</span>
                        @if (link is not null)
                        {
                            <a class="record-link" href="@link" target="_blank" rel="noopener">Open record</a>
                        }
                    </div>
                }
            </div>
        }
        <form class="composer-bar" @onsubmit="Ask" @onsubmit:preventDefault="true">
            <input class="ask-input" @bind="_question" @bind:event="oninput" aria-label="Ask about this week"
                   placeholder="@(_listening ? "Listening..." : "Ask about this week, or tap the mic")"
                   disabled="@(_asking || _listening)" />
            @if (_speaking)
            {
                <button type="button" class="mic stop" @onclick="StopSpeaking" title="Stop" aria-label="Stop speaking">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <rect x="6" y="6" width="12" height="12" rx="2" />
                    </svg>
                </button>
            }
            else if (_listening)
            {
                <button type="button" class="mic on" @onclick="StopListening" title="Stop listening" aria-label="Stop listening">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <rect x="6" y="6" width="12" height="12" rx="2" />
                    </svg>
                </button>
            }
            else
            {
                <button type="button" class="mic" @onclick="AskByVoice"
                        disabled="@_asking" title="Push to talk" aria-label="Push to talk">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2z" />
                    </svg>
                </button>
            }
        </form>
    </div>
}

<div class="log-drawer @(_showLog ? "open" : "")" inert="@(!_showLog)" aria-hidden="@(_showLog ? "false" : "true")">
    <header>
        Activity log
        <button class="close" @onclick="() => _showLog = false" aria-label="Close">&times;</button>
    </header>
    <div class="log-body">
        @if (_log.Count == 0)
        {
            <div class="log-empty">No activity yet. Run the squad to see events, timings, and errors here.</div>
        }
        @foreach (var entry in _log)
        {
            <div class="log-row @entry.Kind @(entry.Error ? "err" : "")">
                <span class="t">@entry.Time</span>
                <span class="d">+@entry.Elapsed</span>
                @if (entry.Agent is not null)
                {
                    <span class="ag ag-@entry.Agent">@entry.Agent</span>
                }
                <span class="m">@entry.Text</span>
            </div>
        }
    </div>
</div>

@code {
    static readonly Archetype[] Cards = [Archetype.Slipping, Archetype.AtRisk, Archetype.Reconnect, Archetype.ReadyToClose];
    static readonly Dictionary<string, string> Stages = new()
    {
        ["watcher"] = "Watcher read the seller's accounts from Dataverse",
        ["thinker"] = "Thinker judged each opportunity against BANT",
        ["ranker"] = "Ranker ordered them by qualification",
        ["operator"] = "Operator reviewed the actions",
        ["challenge"] = "Operator challenged the Thinker, who re-examined",
        ["actions"] = "Operator prepared the actions",
        ["approval"] = "Waiting for your approval",
        ["execute"] = "Applied your decision",
    };

    // The workflow only reports when a stage finishes, so between stages we show what is
    // running now. The reasoning stages take the longest, so this fills the quiet gaps.
    // Keyed by the stage that just completed, valued by the stage now underway.
    static readonly Dictionary<string, string> Working = new()
    {
        ["watcher"] = "Thinker is reasoning over every opportunity against BANT...",
        ["thinker"] = "Ranker is ordering them by qualification...",
        ["ranker"] = "Operator is reviewing the actions...",
        ["operator"] = "Operator is challenging the Thinker...",
        ["challenge"] = "Operator is preparing the actions...",
    };

    static string Label(Archetype archetype) => archetype switch
    {
        Archetype.ReadyToClose => "Ready to close",
        Archetype.AtRisk => "At risk",
        _ => archetype.ToString(),
    };

    // BANT runs 0-4; colour the badge from cold (red) to closeable (green).
    static string BantClass(int score) => score >= 4 ? "b4" : score == 3 ? "b3" : score == 2 ? "b2" : "b1";
    // MEDDPICC runs 0-8; colour the badge on the same cold-to-closeable scale as BANT.
    static string MeddpiccClass(int score) => score >= 6 ? "b4" : score >= 4 ? "b3" : score >= 2 ? "b2" : "b1";

    bool _running;
    Persona _persona = Persona.Sdr;   // the qualification lens; SDR = BANT triage, AE = + MEDDPICC read
    Persona? _ranPersona;             // the persona the current results were built under (null before any run)
    string? _active;
    readonly List<string> _thread = new();
    IReadOnlyList<RankedRecommendation> _recommendations = [];
    IReadOnlyList<ActionProposal> _proposals = [];

    // The grounded question-answer layer over this run's results. Read-only.
    PipelineConversation? _chat;
    readonly List<QaEntry> _qa = new();
    // When an answer carried an approval, this holds its index so the writes it caused can be
    // attached back to that answer once the workflow reports them.
    int? _approvedAt;
    string _question = "";

    // One exchange in the conversation. Writes is filled in later for the answer that approved,
    // so the record links show inside the response text itself, not only in the Done panel.
    sealed class QaEntry(string question, string answer)
    {
        public string Question { get; } = question;
        public string Answer { get; } = answer;
        public List<WriteResult> Writes { get; } = new();
    }

    bool _asking;
    bool _listening;
    bool _speaking;
    bool _disposed;
    readonly HashSet<int> _selected = new();
    TaskCompletionSource<ApprovalDecision>? _pending;
    WriteReport? _report;
    RankedRecommendation? _evidence;

    // The activity log: the raw event stream behind the dialogue, with timings and full
    // error detail. Off by default so the demo stays the three screens; the toggle opens it.
    bool _showLog;
    readonly List<LogEntry> _log = new();
    readonly System.Diagnostics.Stopwatch _clock = new();
    // Kind: "system" (companion's own lifecycle), "progress" (deterministic work from an
    // executor), "thought" (a model's output). Agent names the squad member when known.
    record LogEntry(string Time, string Elapsed, string Text, bool Error, string? Agent, string Kind);

    void Log(string message, bool error = false) => Add(message, error, null, "system");
    void LogTrace(string agent, string message, string kind) => Add(message, false, agent, kind);

    void Add(string message, bool error, string? agent, string kind) =>
        _log.Add(new LogEntry(
            DateTimeOffset.Now.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture),
            _clock.Elapsed.TotalSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "s",
            message,
            error,
            agent,
            kind));

    async Task RunAsync()
    {
        // Guard against a second click landing before the button's re-render hides it.
        if (_running)
        {
            return;
        }
        _running = true;
        // Stop any voice still playing or listening from a previous run before resetting state.
        try
        {
            await JS.InvokeVoidAsync("voiceInterop.stopSpeaking");
            await JS.InvokeVoidAsync("voiceInterop.stopListening");
        }
        catch { /* the JS module may not be loaded yet on the very first run */ }
        _speaking = false;
        _listening = false;
        _thread.Clear();
        _log.Clear();
        _report = null;
        _evidence = null;
        _recommendations = [];
        _proposals = [];
        _chat = null;
        _qa.Clear();
        _approvedAt = null;
        _ranPersona = _persona;   // these results are built under the persona selected now
        _clock.Restart();
        _thread.Add("Starting the squad...");
        _active = "Watcher is reading the seller's accounts from Dataverse...";
        Log("Run started");
        await InvokeAsync(StateHasChanged);

        BuiltSquad? built = null;
        try
        {
            // Build (and the Dataverse client construction it does) off the render thread
            // so the UI stays responsive and the thread updates as the run streams.
            built = await Task.Run(() => Factory.Build(_persona));
            Log("Workflow built, streaming events");
            var run = await InProcessExecution.RunStreamingAsync(built.Workflow, "What should I focus on this week?");

            await foreach (var workflowEvent in run.WatchStreamAsync())
            {
                // The circuit dropped (component disposed) - stop touching the dead UI.
                if (_disposed)
                {
                    break;
                }
                switch (workflowEvent)
                {
                    // Deterministic work and model output stream in as they happen - which agent
                    // is doing what, the Dataverse reads, the archetype calls, the actions. Two
                    // event types, two code paths (see CLAUDE.md).
                    case AgentProgressEvent progress:
                        LogTrace(progress.Agent, progress.Message, "progress");
                        await InvokeAsync(StateHasChanged);
                        break;

                    case AgentThoughtEvent thought:
                        LogTrace(thought.Agent, thought.Text, "thought");
                        await InvokeAsync(StateHasChanged);
                        break;

                    case ExecutorCompletedEvent completed:
                        // The approval port completes twice (emitting the request, then again on
                        // the response), so skip a label identical to the last to avoid a dupe.
                        var stage = Stages.GetValueOrDefault(completed.ExecutorId, completed.ExecutorId);
                        if (_thread.Count == 0 || _thread[^1] != stage)
                        {
                            _thread.Add(stage);
                        }
                        _active = Working.GetValueOrDefault(completed.ExecutorId);
                        await InvokeAsync(StateHasChanged);
                        break;

                    case RequestInfoEvent requestInfo when requestInfo.Request.Data.As<ApprovalRequest>() is { } approvalRequest:
                        _active = null;
                        _recommendations = approvalRequest.Recommendations;
                        _proposals = approvalRequest.Proposals;
                        _selected.Clear();   // a fresh round: nothing pre-selected
                        // The results are in - the seller can now ask about them. Built once; later
                        // rounds keep the same conversation (the analysis has not changed).
                        _chat ??= Factory.BuildConversation(SerializeAnalysis());
                        _pending = new TaskCompletionSource<ApprovalDecision>(TaskCreationOptions.RunContinuationsAsynchronously);
                        Log($"approval requested: {approvalRequest.Proposals.Count} proposals");
                        await InvokeAsync(StateHasChanged);
                        var decision = await _pending.Task;
                        _pending = null;
                        _active = decision.Approved.Count > 0 ? "Writing the approved actions to Dataverse..." : null;
                        Log($"decision sent: {decision.Approved.Count} approved, {decision.Next?.Proposals.Count ?? 0} kept for another round");
                        await run.SendResponseAsync(requestInfo.Request.CreateResponse(decision));
                        await InvokeAsync(StateHasChanged);
                        break;

                    case WorkflowOutputEvent { Data: WriteReport report }:
                        _report = report;
                        // Attach the written records to the answer that approved them, so the
                        // links appear inside that response bubble too - not only in the panel.
                        if (_approvedAt is int at && at < _qa.Count)
                        {
                            _qa[at].Writes.AddRange(report.Lines.Where(line => line.RecordId is not null));
                            _approvedAt = null;
                        }
                        foreach (var line in report.Lines)
                        {
                            Log(line.Message);
                        }
                        await InvokeAsync(StateHasChanged);
                        break;
                }
            }

            Log("Run finished in " + _clock.Elapsed.TotalSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "s");
        }
        catch (Exception ex)
        {
            _thread.Add($"Error: {ex.Message}");
            // Full detail in the log, and open the drawer so a failure is never silent.
            Log(ex.ToString(), error: true);
            _showLog = true;
        }
        finally
        {
            // Dispose the Dataverse ServiceClients the build created for this run.
            if (built is not null)
            {
                foreach (var resource in built.Resources)
                {
                    resource.Dispose();
                }
            }
            _active = null;
            _running = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // The typed path: ask what is in the input.
    Task Ask() => RunAsk(_question);

    // Ask one question through the conversation, render the answer, and apply any command it
    // carried. Returns the answer text so the voice path can read it aloud.
    async Task<string> RunAsk(string raw)
    {
        var question = raw.Trim();
        if (question.Length == 0 || _chat is null || _asking)
        {
            return "";
        }
        _question = "";
        _asking = true;
        await InvokeAsync(StateHasChanged);
        var answer = "";
        try
        {
            var result = await _chat.AskAsync(question);
            answer = result.Answer;
            _qa.Add(new QaEntry(question, result.Answer));
            // Apply the conversation's intent here, on the dispatcher - the tools only recorded
            // it. Selection and approval go through the same state the checkboxes and buttons use.
            ApplyCommands(result);
            // Remember which answer approved, so its record links can attach when writes report.
            if (result.Action is TurnAction.Approve or TurnAction.ApproveAll)
            {
                _approvedAt = _qa.Count - 1;
            }
        }
        catch (Exception ex)
        {
            // Show the failure, but return empty so the voice path does not read the error aloud.
            _qa.Add(new QaEntry(question, $"(error: {ex.Message})"));
            answer = "";
        }
        finally
        {
            _asking = false;
            await InvokeAsync(StateHasChanged);
        }
        return answer;
    }

    // The voice path: listen for one utterance, ask it, and read the answer aloud (push to
    // talk). Speech only transcribes and synthesises - the conversation stays the brain.
    async Task AskByVoice()
    {
        if (_chat is null || _asking || _listening)
        {
            return;
        }
        _listening = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var text = await JS.InvokeAsync<string>("voiceInterop.recognizeOnce");
            _listening = false;
            await InvokeAsync(StateHasChanged);
            if (!string.IsNullOrWhiteSpace(text))
            {
                var answer = await RunAsk(text);
                _speaking = true;
                await InvokeAsync(StateHasChanged);
                try
                {
                    await JS.InvokeVoidAsync("voiceInterop.speak", answer);
                }
                finally
                {
                    _speaking = false;
                }
            }
        }
        catch (Exception ex)
        {
            _qa.Add(new QaEntry("(voice)", $"(voice error: {ex.Message})"));
        }
        finally
        {
            _listening = false;
            _speaking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Cut the spoken answer short. speak() resolves as soon as playback stops, so AskByVoice
    // falls through its finally and the button flips back to the mic.
    async Task StopSpeaking() => await JS.InvokeVoidAsync("voiceInterop.stopSpeaking");

    // Cancel an in-progress listen so the composer never locks until Azure's silence timeout.
    // recognizeOnce returns empty, AskByVoice asks nothing and clears _listening in its finally.
    async Task StopListening() => await JS.InvokeVoidAsync("voiceInterop.stopListening");

    // A dropped SignalR circuit disposes the component. Release the approval gate so the run is
    // not stranded waiting forever, and mark disposed so a still-streaming run stops re-rendering.
    public void Dispose()
    {
        _disposed = true;
        _pending?.TrySetResult(new ApprovalDecision([]));
    }

    // The deep link for a written record, or null for lines that wrote nothing (skips, stubs,
    // "nothing written"). Shared by the Done panel and the composer's write confirmation.
    string? RecordLink(WriteResult line) =>
        line.RecordId is { } id && line.EntityLogicalName is { } entity ? Factory.RecordUrl(entity, id) : null;

    // The conversation asked to select and/or approve. It can only touch this run's proposals
    // and the existing gate - the same authority as the checkboxes and the approve/reject buttons.
    void ApplyCommands(ConversationTurn turn)
    {
        foreach (var number in turn.Proposals)
        {
            if (_proposals.Any(proposal => proposal.Number == number))
            {
                _selected.Add(number);
            }
        }
        switch (turn.Action)
        {
            case TurnAction.Approve:
                _pending?.SetResult(Decide(_proposals.Where(proposal => _selected.Contains(proposal.Number)).ToList()));
                break;
            case TurnAction.ApproveAll:
                _pending?.SetResult(Decide(_proposals));
                break;
            case TurnAction.RejectAll:
                _pending?.SetResult(new ApprovalDecision([]));
                break;
        }
    }

    // The run's results, handed to the conversation as its only source. Enum names, not
    // integers, so the assistant reads "ReadyToClose" and "Confirmed"; and evidence without
    // the raw record id, so it cites "the note from 20 August", never a GUID.
    string SerializeAnalysis() =>
        JsonSerializer.Serialize(
            new
            {
                accounts = _recommendations.Select(recommendation =>
                {
                    var assessment = recommendation.Assessment;
                    return new
                    {
                        assessment.AccountName,
                        assessment.OpportunityName,
                        assessment.Amount,
                        assessment.CloseDate,
                        assessment.CrmStage,
                        assessment.Archetype,
                        assessment.Confidence,
                        assessment.Rationale,
                        Bant = new
                        {
                            Budget = Axis(assessment.Bant.Budget),
                            Authority = Axis(assessment.Bant.Authority),
                            Need = Axis(assessment.Bant.Need),
                            Timing = Axis(assessment.Bant.Timing),
                        },
                        // AE persona only: the MEDDPICC read, so the spokesperson can answer on it.
                        Meddpicc = recommendation.Meddpicc is { } scorecard ? MeddpiccProjection(scorecard) : null,
                    };
                }),
                actions = _proposals.Select(proposal => new { proposal.Number, proposal.OpportunityName, proposal.Action.Type, proposal.Action.Title }),
            },
            new JsonSerializerOptions { Converters = { new JsonStringEnumConverter() } });

    static object Axis(BantCriterion criterion) => new
    {
        criterion.Status,
        criterion.Reasoning,
        Evidence = criterion.Evidence.Select(evidence => new { evidence.EntityLogicalName, evidence.Date, evidence.Excerpt }),
    };

    static object MeddpiccProjection(MeddpiccScorecard s) => new
    {
        Metrics = Element(s.Metrics),
        EconomicBuyer = Element(s.EconomicBuyer),
        DecisionCriteria = Element(s.DecisionCriteria),
        DecisionProcess = Element(s.DecisionProcess),
        PaperProcess = Element(s.PaperProcess),
        IdentifyPain = Element(s.IdentifyPain),
        Champion = Element(s.Champion),
        Competition = Element(s.Competition),
    };

    static object Element(MeddpiccElement element) => new
    {
        element.Status,
        element.Reasoning,
        Evidence = element.Evidence.Select(evidence => new { evidence.EntityLogicalName, evidence.Date, evidence.Excerpt }),
    };

    void Toggle(int number, ChangeEventArgs e)
    {
        if (e.Value is true) { _selected.Add(number); } else { _selected.Remove(number); }
    }

    void ApproveSelected() => _pending?.SetResult(Decide(_proposals.Where(p => _selected.Contains(p.Number)).ToList()));
    void ApproveAll() => _pending?.SetResult(Decide(_proposals));
    void RejectAll() => _pending?.SetResult(new ApprovalDecision([]));

    // Build the decision for a partial approval: write the approved, and if any proposals remain,
    // re-open the gate with them (Next) so nothing is lost. Approving everything ends the run.
    ApprovalDecision Decide(IReadOnlyList<ActionProposal> approved)
    {
        var approvedNumbers = approved.Select(proposal => proposal.Number).ToHashSet();
        var remaining = _proposals.Where(proposal => !approvedNumbers.Contains(proposal.Number)).ToList();
        var next = approved.Count > 0 && remaining.Count > 0 ? new ApprovalRequest(_recommendations, remaining) : null;
        return new ApprovalDecision(approved, next);
    }
    void ShowEvidence(RankedRecommendation recommendation) => _evidence = recommendation;

    static IEnumerable<(string Element, MeddpiccElement Criterion)> MeddpiccElements(MeddpiccScorecard s) =>
    [
        ("Metrics", s.Metrics), ("Economic buyer", s.EconomicBuyer), ("Decision criteria", s.DecisionCriteria),
        ("Decision process", s.DecisionProcess), ("Paper process", s.PaperProcess), ("Identify pain", s.IdentifyPain),
        ("Champion", s.Champion), ("Competition", s.Competition),
    ];

    static IEnumerable<(string Axis, BantCriterion Criterion)> Axes(BantAssessment bant) =>
    [
        ("Budget", bant.Budget), ("Authority", bant.Authority), ("Need", bant.Need), ("Timing", bant.Timing),
    ];
}
